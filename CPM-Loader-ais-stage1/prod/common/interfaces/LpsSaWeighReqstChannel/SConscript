# Build Channel.Input.so
ifaceChannelInput = baseEnv.SharedLibraryWrapper(
    target='LpsSaWeighReqstChannel.Channel.Input.so',
    source='Channel/Input/channel.cpp',
    LIBS = ['ais_serialization', 'ais_channel', baseEnv['BOOST_SIGNALS'] ],
)

# Build Channel.Output.so
ifaceChannelOutput = baseEnv.SharedLibraryWrapper(
    target='LpsSaWeighReqstChannel.Channel.Output.so',
    source='Channel/Output/channel.cpp',
    LIBS = ['ais_serialization', 'ais_channel' ],
)

# Build Restorable
ifaceRestorable = baseEnv.SharedLibraryWrapper(
    target='LpsSaWeighReqstChannel.Restorable.so',
    source='Restorable/Restorable.cpp',
    LIBS = ['ais_serialization'],
)

# Build TypeTraits
ifaceTypeTraits = baseEnv.SharedLibraryWrapper(
  target='LpsSaWeighReqstChannel.TypeTraits.so',
  source=[
       'TypeTraits/csvable.cpp',
        'TypeTraits/textWritable.cpp',
   ],
   LIBS = ['ais_serialization'],
)


#!/usr/bin/python
import os
import glob
Import( 'baseEnv' )
commonEnv = baseEnv.Clone();
Export( 'commonEnv' )
#Addon----------------------------------------
BASE_PATH = '/home/u_via/repo/ssp-CPM_Loader-ais'

for d in glob.glob(BASE_PATH + '/ros2_jazzy_sdk/include/*'):
    if os.path.isdir(d):
        commonEnv.Append(CPPPATH=[d])
#------------------------------------------------
commonEnv.buildit( 'interfaces', ['suse'] )

# A7H4 (arm64_guest) does not have these A6N2/x86-specific libraries
if acEnv['PLATFORM'] == 'A7H4':
    a7h4_unavailable = [
        'csf_pgt_server',    # CSF_PGT_SERVER_SUPPORTED=0 for A7H4
        'csf_http_server',
        'microServiceLib',
        'grpc',
        'gpr',
        'grpc++',
        'cdl2_gen',          # not built for tgt_gcc_arm64_guest
        # NOTE: cdl2_ must stay - libcal.a(cal_interface_init.o) needs cdl2_transmit
        # cdl2_utils.o stubs (cdl_tx_msg_stat etc.) provided by cdl_fix.c
        'cdl_',              # legacy CDL - references hal_cdl_* unavailable on A7H4
        'scl_stat_db',       # SCL_STAT_DB_SUPPORTED=0; config vars and hal_eth_statistics_* unavailable
        'hal_util',          # not in tgt_gcc_arm64_guest (confirmed by bmiJ1939 SConscript)
        'hal_cdl_a6n2',      # A6N2-specific HAL
        'hal_error',         # not in tgt_gcc_arm64_guest (confirmed by bmiJ1939 SConscript)
        'hal_eth_statistics', # HAL_ETH_STATISTICS_SUPPORTED=0 for A7H4
        'bcm89501',
        'micrel_ksz8567',
    ]
    libsList = [lib for lib in libsList if lib not in a7h4_unavailable]
    # hal_boot -> hal_boot_read_location_code -> hal_pulsei_get_discrete -> hal_ipc_client
    # hal_ipc_client needs ipc_client_init/ipc_client_send from libipc.a
    # ipc appears early in libsList so must be repeated after hal_ipc_client for correct link order
    libsList.append('hal_pulsei')
    libsList.append('hal_ipc_client')
    libsList.append('ipc')   # repeated: hal_ipc_client needs ipc_client_init/ipc_client_send

autonomyConditionDiagnostics = acEnv.ProgramWrapper(
        target = 'autonomyConditionDiagnostics',
        source = sourceFiles,
        LIBS = libsList
    )

acEnv.InstallBinary(autonomyConditionDiagnostics)

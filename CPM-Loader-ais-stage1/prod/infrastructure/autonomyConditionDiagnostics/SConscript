#Import('infEnv')
#acEnv = infEnv.Clone();

Import( 'testEnv' )
acEnv = testEnv.Clone();

# Include the super-project directory so that we can find lps_common
# source files.
Repository(acEnv['SSP_DIR'])

targetAppVariant = acEnv.get('TARGET_APP_VARIANT', None)

pluginDir = acEnv['TES_COMMON_DIR'] + '/prod/infrastructure/plugins/'

# Please people, stop creating so many warnings!
acEnv.Append(CCFLAGS = [
    '-Werror', '-Wno-unused-function'
])

acEnv.Append(LIBPATH = [
    acEnv['TES_COMMON_DIR'] + '/apps/lib/'
])

acEnv.Append(CPPPATH = [
    '.',
    acEnv['TES_COMMON_DIR'] + '/apps/include',
    pluginDir + 'EthernetPortStatistics',
])

#Added so that the autonomyConditionDiagnostics task can use stuff from the mci lib
#acEnv.Append(CPPPATH = ['#prod/infrastructure/mci']);
#acEnv.Append(LIBPATH = ['#/prod/infrastructure/autonomyConditionDiagnostics/lib'])
acEnv.Append(CPPPATH = ['#/prod/infrastructure/autonomyConditionDiagnostics/src_acdcalinf'])
#acEnv.Append(CPPPATH = ['#/prod/infrastructure/autonomyConditionDiagnostics/include/lib_a4/scl'])
acEnv.Append(CPPPATH = ['#prod/infrastructure/catdl']);

# Include paths
acEnv.Append(CPPPATH = [
    '#/lps_common/include'
])

sourceFiles = [ 
    # This file is built in various apps, so we need to give the object a unique path for this app.
    acEnv.Object('LpsCommonWeight', '#/lps_common/src/LpsCommonWeight.c'),

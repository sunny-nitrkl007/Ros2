]

# A7H4: exclude source files whose APIs are unavailable (CSF_PGT_SERVER_SUPPORTED=0)
# and add cdl_fix.c stubs so libcdl_ (and hal_cdl_* hardware) are not needed
if acEnv['PLATFORM'] == 'A7H4':
    a7h4_exclude_sources = [
        'src_pgt_server/app_pgt.c',               # calls csf_httpd_*/csf_pgt_server_init - unavailable
        'src_pgt_server/app_pgt_server_config.c',  # CSF_PGT_SERVER_SUPPORTED=0 for A7H4
    ]
    sourceFiles = [s for s in sourceFiles if s not in a7h4_exclude_sources]
    # Provide cdl_tx_msg_stat_reset/cdl_tx_msg_stat/cdl_enq_tx_msg stubs so that
    # libcdl2_.a(cdl2_utils.o) symbols are satisfied without linking libcdl_
    # (which would pull in hal_cdl_* hardware symbols unavailable on A7H4)
    sourceFiles.append('src_catdl/cdl_fix.c')

if targetAppVariant is not None:
    sourceFiles += Glob(targetAppVariant + '/*.cpp')


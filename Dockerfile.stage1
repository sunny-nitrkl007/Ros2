# Stage 1 direct-DDS test harness (Development-Plan.txt Step 6.1 /
# Stage-Build-Test-Roadmap.txt). No AIS SDK anywhere in this image --
# only rclcpp, the cpm_common_interfaces messages, and the two AIS-free
# real files (ros_shim/*.h, LpsSaWeighAppInf.hpp).
#
# Build (from cpm/, so the build context can reach both CPM-Loader-ais
# and ros2_ws):
#   docker build -f Dockerfile.stage1 -t cpm-stage1-harness .
#
# Run both harness nodes in one container (simplest -- shares loopback,
# no cross-container DDS discovery to configure):
#   docker run --rm -it cpm-stage1-harness

FROM ros:jazzy-ros-base

SHELL ["/bin/bash", "-c"]

WORKDIR /workspace

# Only the pieces Stage 1 actually needs.
COPY CPM-Loader-ais/prod/common/ros_shim CPM-Loader-ais/prod/common/ros_shim
COPY CPM-Loader-ais/prod/common/interfaces/LpsSaWeighReqstChannel CPM-Loader-ais/prod/common/interfaces/LpsSaWeighReqstChannel
COPY ros2_ws/src/cpm_common_interfaces ros2_ws/src/cpm_common_interfaces
COPY ros2_ws/src/direct_dds_test_harness ros2_ws/src/direct_dds_test_harness
COPY docker/run_stage1.sh /run_stage1.sh

WORKDIR /workspace/ros2_ws
RUN source /opt/ros/jazzy/setup.bash && \
    colcon build --packages-select cpm_common_interfaces direct_dds_test_harness

RUN chmod +x /run_stage1.sh
ENTRYPOINT ["/run_stage1.sh"]

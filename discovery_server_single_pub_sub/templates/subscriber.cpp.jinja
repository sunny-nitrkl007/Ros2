#include "rclcpp/rclcpp.hpp"
#include "{{ msg_include }}"
#include "{{ node.name }}.hpp"

{{ node.name | capitalize }}::{{ node.name | capitalize }}()
    : Node("{{ node.name }}")
{
    this->declare_parameter<std::string>(
        "log_prefix", "{{ node.parameters.log_prefix }}");

    log_prefix_ = this->get_parameter("log_prefix").as_string();

    rclcpp::QoS qos(rclcpp::KeepLast({{ node.qos.depth }}));

    {% if node.qos.reliability == "reliable" %}
    qos.reliable();
    {% else %}
    qos.best_effort();
    {% endif %}

    subscription_ = this->create_subscription<{{ msg_type }}>(
        "{{ node.topic }}", qos,
        std::bind(&{{ node.name | capitalize }}::callback, this, std::placeholders::_1));
}

void {{ node.name | capitalize }}::callback(const {{ msg_type }}::SharedPtr msg)
{
    RCLCPP_INFO(this->get_logger(), "%s %s",
        log_prefix_.c_str(), msg->data.c_str());
}

int main(int argc, char * argv[])
{
    rclcpp::init(argc, argv);
    auto node = std::make_shared<{{ node.name | capitalize }}>();
    rclcpp::spin(node);
    rclcpp::shutdown();
    return 0;
}
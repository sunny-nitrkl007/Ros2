generator:
  name: ros2_generator
  version: 1.1.0-v1-core-option-b-interfaces
package: {{ app.package_name }}
code_layout: {{ code_layout.mode }}
interfaces:
  messages: {{ interfaces.messages|length }}
  services: {{ interfaces.services|length }}
optional_artifacts:
  config: {{ generation.config }}
  launch: {{ generation.launch }}
  tests: {{ generation.tests }}
  scripts: {{ generation.scripts }}
created_files:
{% for f in created_files %}
  - {{ f }}
{% endfor %}

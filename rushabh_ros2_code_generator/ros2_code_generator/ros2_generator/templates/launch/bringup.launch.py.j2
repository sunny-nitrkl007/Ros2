from launch import LaunchDescription
from launch_ros.actions import Node
from ament_index_python.packages import get_package_share_directory
import os


def generate_launch_description():
    pkg_share = get_package_share_directory('{{ app.package_name }}')
    params = os.path.join(pkg_share, 'config', 'params.yaml')
    return LaunchDescription([
{% for node in nodes %}
        Node(package='{{ app.package_name }}', executable='{{ node.executable }}', name='{{ node.name }}', namespace='{{ app.namespace }}', output='screen', parameters=[params], arguments=['--ros-args', '--log-level', '{{ node.logging.level }}']),
{% endfor %}
    ])

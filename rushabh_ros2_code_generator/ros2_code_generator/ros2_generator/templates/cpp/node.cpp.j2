{% if sub.watchdog.enabled %}
void {{ node.class_name }}::check_watchdog_{{ sub.name }}()
{
  // Purpose: Detect stale input for subscriber '{{ sub.name }}'.
  // Version: v1.0.0 - Initial subscriber watchdog generation.
  if (!{{ sub.name }}_has_msg_) {
    RCLCPP_{{ 'ERROR' if sub.watchdog.severity == 'error' else 'WARN' }}(
      this->get_logger(), "Watchdog waiting for first message on {{ sub.topic.topic_name }}.");
    return;
  }
  const auto age_ms = (this->now() - {{ sub.name }}_last_msg_time_).nanoseconds() / 1000000;
  if (age_ms > {{ sub.watchdog.timeout_ms }}) {
    RCLCPP_{{ 'ERROR' if sub.watchdog.severity == 'error' else 'WARN' }}(
      this->get_logger(), "Watchdog timeout on {{ sub.topic.topic_name }}: %ld ms", age_ms);
{% if sub.watchdog.user_hook %}
    user_logic_.{{ sub.watchdog.user_hook }}();
{% endif %}
  }
}
{% endif %}

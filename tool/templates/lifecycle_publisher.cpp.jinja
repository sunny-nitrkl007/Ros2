#include "rclcpp/rclcpp.hpp"
#include "rclcpp_lifecycle/lifecycle_node.hpp"
#include "{{ msg_include }}"
#include "{{ node.name }}.hpp"

using namespace std::chrono_literals;
using CallbackReturn = rclcpp_lifecycle::node_interfaces::LifecycleNodeInterface::CallbackReturn;

// State machine:
//   unconfigured  -->  on_configure()  -->  inactive
//   inactive      -->  on_activate()   -->  active       (timer starts, publishes)
//   active        -->  on_deactivate() -->  inactive     (timer stops)
//   inactive      -->  on_cleanup()    -->  unconfigured (publisher destroyed)
//   any           -->  on_shutdown()   -->  finalized

{{ node.name | capitalize }}::{{ node.name | capitalize }}()
{% if node.namespace %}
    : rclcpp_lifecycle::LifecycleNode("{{ node.name }}", "{{ node.namespace }}")
{% else %}
    : rclcpp_lifecycle::LifecycleNode("{{ node.name }}")
{% endif %}
{
    RCLCPP_INFO(this->get_logger(),
        "Node created. Current state: unconfigured.");
}

CallbackReturn {{ node.name | capitalize }}::on_configure(const rclcpp_lifecycle::State &)
{
    this->declare_parameter<double>("publish_rate", {{ node.parameters.publish_rate | default(1.0) }});
    publish_rate_ = this->get_parameter("publish_rate").as_double();

    rclcpp::QoS qos(rclcpp::KeepLast({{ node.qos.depth | default(10) }}));
    {% if node.qos.reliability == "reliable" %}
    qos.reliable();
    {% else %}
    qos.best_effort();
    {% endif %}

    publisher_ = this->create_publisher<{{ msg_type }}>("{{ node.topic }}", qos);

    RCLCPP_INFO(this->get_logger(),
        "on_configure: publisher created on '{{ node.topic }}' at %.1f Hz. State: inactive.",
        publish_rate_);
    return CallbackReturn::SUCCESS;
}

CallbackReturn {{ node.name | capitalize }}::on_activate(const rclcpp_lifecycle::State &)
{
    publisher_->on_activate();

    timer_ = this->create_wall_timer(
        std::chrono::milliseconds(static_cast<int>(1000.0 / publish_rate_)),
        std::bind(&{{ node.name | capitalize }}::publish_message, this));

    RCLCPP_INFO(this->get_logger(),
        "on_activate: publishing started. State: active.");
    return CallbackReturn::SUCCESS;
}

CallbackReturn {{ node.name | capitalize }}::on_deactivate(const rclcpp_lifecycle::State &)
{
    timer_.reset();
    publisher_->on_deactivate();

    RCLCPP_INFO(this->get_logger(),
        "on_deactivate: publishing stopped. State: inactive.");
    return CallbackReturn::SUCCESS;
}

CallbackReturn {{ node.name | capitalize }}::on_cleanup(const rclcpp_lifecycle::State &)
{
    publisher_.reset();

    RCLCPP_INFO(this->get_logger(),
        "on_cleanup: publisher destroyed. State: unconfigured.");
    return CallbackReturn::SUCCESS;
}

CallbackReturn {{ node.name | capitalize }}::on_shutdown(const rclcpp_lifecycle::State &)
{
    timer_.reset();
    publisher_.reset();

    RCLCPP_INFO(this->get_logger(), "on_shutdown: node finalizing.");
    return CallbackReturn::SUCCESS;
}

void {{ node.name | capitalize }}::publish_message()
{
    auto msg = {{ msg_type }}();
    msg.data = "Hello from {{ node.name }}! count=" + std::to_string(count_++);
    RCLCPP_INFO(this->get_logger(), "Publishing: '%s'", msg.data.c_str());
    publisher_->publish(msg);
}

int main(int argc, char * argv[])
{
    rclcpp::init(argc, argv);
    auto node = std::make_shared<{{ node.name | capitalize }}>();
    rclcpp::spin(node->get_node_base_interface());
    rclcpp::shutdown();
    return 0;
}

# Everything in this folder is ignored by default -- only the specific
# files we're actively touching for the ROS2/DDS migration are tracked.
# Everything else (the full ssp-CPM_Loader-ais checkout, etc.) stays on
# disk exactly as-is, untouched by and invisible to git.
/*

!/CPM-Loader-ais/
!/CPM-Loader-ais-stage1/
!/CPM-Loader-ais-stage1-rosChannels/
!/ros2_ws/
!/ROS2_Service_Discovery.zip
!/.gitignore
!/Dockerfile.stage1
!/docker/
!/docker/**
!/DDSWeighAppInf-vs-LpsSaWeighAppInf.diff.txt
!/Shared-Wrapper-Class-Audit.txt

# colcon build artifacts (left on disk by interactive/mounted builds --
# never appear from a plain `docker build`, which only COPYs src/)
/ros2_ws/build/
/ros2_ws/install/
/ros2_ws/log/
